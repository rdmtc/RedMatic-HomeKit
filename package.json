{
  "name": "redmatic-homekit",
  "version": "4.0.0-dev.15",
  "description": "HAP-NodeJS based Node-RED nodes to create HomeKit accessories, with automatic mapping of Homematic devices",
  "main": "none",
  "author": "Sebastian Raff <hobbyquaker@gmail.com>",
  "contributors": [
    "Jérôme https://github.com/jp112sdl",
    "Matthias https://github.com/ptweety",
    "Julian Pawlowski https://github.com/jpawlowski",
    "https://github.com/kneip68"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdmtc/RedMatic-HomeKit.git"
  },
  "bugs": {
    "url": "https://github.com/rdmtc/RedMatic-HomeKit/issues"
  },
  "homepage": "https://github.com/rdmtc/RedMatic-HomeKit",
  "keywords": [
    "node-red",
    "smart home automation",
    "hap",
    "homekit",
    "siri",
    "homematic",
    "homematic-ip",
    "ccu",
    "redmatic"
  ],
  "files": [
    "nodes/",
    "homematic-devices/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.12 || >=24"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "redmatic-homekit-bridge": "nodes/redmatic-homekit-bridge.js",
      "redmatic-homekit-homematic-devices": "nodes/redmatic-homekit-homematic-devices.js",
      "redmatic-homekit-homematic-garage": "nodes/redmatic-homekit-homematic-garage.js",
      "redmatic-homekit-homematic-irrigation": "nodes/redmatic-homekit-homematic-irrigation.js",
      "redmatic-homekit-switch": "nodes/redmatic-homekit-switch.js",
      "redmatic-homekit-pseudobutton": "nodes/redmatic-homekit-pseudobutton.js",
      "redmatic-homekit-statelessprogrammableswitch": "nodes/redmatic-homekit-statelessprogrammableswitch.js",
      "redmatic-homekit-universal": "nodes/redmatic-homekit-universal.js",
      "redmatic-homekit-tv": "nodes/redmatic-homekit-tv.js"
    }
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "npm run lint && npm run test:unit && npm run check:native",
    "test:unit": "node --test \"test/**/*.test.js\"",
    "check:native": "node tools/check-native.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@homebridge/hap-nodejs": "^2.2.3"
  }
}
